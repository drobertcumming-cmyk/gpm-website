# Grace Precious Metals — environment variables
# Copy this file to .env.local and populate. Never commit .env.local.
# Reference: DESIGN_BRIEF.md Section 37.6.

# Klaviyo
# Private key — server-side, used by /api/briefing and /api/contact route handlers.
KLAVIYO_PRIVATE_KEY=pk_xxx
# Public key — client-side identity for the Klaviyo SDK.
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=YYY

# Google Analytics 4
# Measurement ID. Loaded via @next/third-parties in app/layout.tsx.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site
# Production URL. Used for canonical URLs and OG image absolute paths.
NEXT_PUBLIC_SITE_URL=https://gracepreciousmetals.com

# Briefing PDF
# Static URL where The Secret Gold Briefing PDF is hosted. Klaviyo flow links to this.
# Renamed from "Just Weight Briefing" on 2026-04-29 per the production brief (CMO Option A).
# For local form-flow testing, a placeholder PDF may be served from public/ — set the
# value to /the-secret-gold-briefing.pdf in .env.local.
BRIEFING_PDF_URL=https://files.gracepreciousmetals.com/the-secret-gold-briefing.pdf

# Trust strip
# Toggles the fourth trust-strip signal "IRS-APPROVED CUSTODIAN & DEPOSITORY" on the homepage.
# Default false — flip to true once partner contracts close (LB-06) and counsel clears
# partner naming for public surface. When false, the strip renders three signals.
TRUST_STRIP_CUSTODIAN_PARTNERSHIPS_CONFIRMED=false

# Contact form
# Internal email destination for /api/contact submissions.
CONTACT_NOTIFICATION_EMAIL=team@gracepreciousmetals.com

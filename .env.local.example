# Grace Precious Metals — environment variables
# Copy this file to .env.local and populate. Never commit .env.local.
# Reference: DESIGN_BRIEF.md Section 37.6.

# Klaviyo
# Private key — server-side, used by /api/briefing and /api/contact route handlers.
KLAVIYO_PRIVATE_KEY=pk_xxx
# Public key — client-side identity for the Klaviyo SDK.
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=YYY

# Google Analytics 4
# Measurement ID. Loaded via @next/third-parties in app/layout.tsx.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site
# Production URL. Used for canonical URLs and OG image absolute paths.
NEXT_PUBLIC_SITE_URL=https://gracepreciousmetals.com

# Briefing PDF
# Static URL where the Just Weight Briefing PDF is hosted. Klaviyo flow links to this.
BRIEFING_PDF_URL=https://files.gracepreciousmetals.com/briefing.pdf

# Contact form
# Internal email destination for /api/contact submissions.
CONTACT_NOTIFICATION_EMAIL=team@gracepreciousmetals.com
